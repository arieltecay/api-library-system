# Environment
NODE_ENV=development

# Server
PORT=3000

# MongoDB - use MONGODB_URI for full connection string or individual vars
MONGODB_URI="mongodb+srv://your_db_user:your_db_password@cluster0.mongodb.net/library_system?retryWrites=true&w=majority"
# Alternatively, use individual components:
# MONGODB_USERNAME="your_db_user"
# MONGODB_PASSWORD="your_db_password"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Bcrypt
BCRYPT_ROUNDS=12

# Frontend URLs (CORS)
FRONTEND_POS_URL="http://localhost:5173"
FRONTEND_ADMIN_URL="http://localhost:5174"

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# MercadoPago (optional)
MERCADOPAGO_ACCESS_TOKEN=""

# Email (optional)
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Library System <noreply@librarysystem.com>"