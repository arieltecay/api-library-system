{
  "name": "librarysystem-api",
  "version": "1.0.0",
  
  "description": "Library System API - Backend for school library POS and Admin",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "seed:dev": "NODE_ENV=development tsx scripts/seed.ts",
    "seed:prod": "NODE_ENV=production tsx scripts/seed.ts",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.8.0",
    "mongoose": "^8.23.0",
    "nodemailer": "^6.9.13",
    "winston": "^3.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
